# MacroFlow-Lakehouse Environment Template
# Copy to .env and populate real credentials before running Docker Compose.

AIRFLOW_IMAGE_NAME=macroflow-airflow:latest
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-valid-fernet-key

# Airflow Metadata DB & Local Web UI
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace-with-strong-password

# Databricks Workspace & Storage Paths
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace-with-databricks-pat
DATABRICKS_CLUSTER_ID=replace-with-cluster-id
DATABRICKS_RAW_BASE_PATH=/Volumes/macroflow/bronze/raw_data
DATABRICKS_SCRIPTS_BASE_PATH=/Volumes/macroflow/artifacts/scripts/databricks
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://?host=https%3A%2F%2Fyour-workspace.cloud.databricks.com&token=replace-with-databricks-pat

# Snowflake Serving Warehouse (Databricks writes via dbutils.secrets in production)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=replace-with-snowflake-password
SNOWFLAKE_DATABASE=MACROFLOW_DW
SNOWFLAKE_SCHEMA=GOLD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=MACROFLOW_ETL_ROLE

ENVIRONMENT=development
LOG_LEVEL=INFO
